    body {
      font-family: 'Noto Sans Thai', 'Sarabun', system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
      font-size: 1rem;
      line-height: 1.6;
      background-color: var(--bg-primary);
      color: var(--text-main);
      padding-bottom: 110px;
      transition: background-color 0.25s ease, color 0.25s ease;
    }

    .app-container {
      max-width: 600px;
      margin: 0 auto;
      padding: 16px 14px;
    }

    /* Header & Profile Summary */
    .app-header {
      background: var(--bg-card);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-lg);
      padding: 18px 16px;
      box-shadow: var(--shadow-sm);
      margin-bottom: 16px;
    }

    .header-top {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 12px;
      margin-bottom: 12px;
    }

    .app-title {
      font-size: 1.35rem;
      font-weight: 800;
      line-height: 1.3;
      letter-spacing: -0.01em;
    }

    .theme-btn {
      min-height: 48px;
      min-width: 48px;
      padding: 0 14px;
      border-radius: var(--radius-sm);
      border: 1px solid var(--border-color);
      background: var(--bg-subtle);
      color: var(--text-main);
      font-family: inherit;
      font-size: 1rem;
      font-weight: 600;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      flex-shrink: 0;
    }

    .profile-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }

    .profile-pill {
      font-size: 1rem;
      font-weight: 600;
      padding: 6px 12px;
      border-radius: 999px;
      background: var(--bg-subtle);
      color: var(--text-secondary);
      border: 1px solid var(--border-color);
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }

    /* Routine Timeline Bar */
    .section-card {
      background: var(--bg-card);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-lg);
      padding: 16px;
      box-shadow: var(--shadow-sm);
      margin-bottom: 16px;
    }

    .section-title {
      font-size: 1.1rem;
      font-weight: 700;
      margin-bottom: 6px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
    }

    .section-subtitle {
      font-size: 1rem;
      color: var(--text-secondary);
      margin-bottom: 12px;
    }

    .timeline-track {
      display: grid;
      grid-template-columns: repeat(7, 1fr);
      gap: 6px;
      margin-bottom: 10px;
    }

    .timeline-node {
      min-height: 64px;
      border-radius: var(--radius-sm);
      border: 2px solid var(--border-color);
      background: var(--bg-subtle);
      color: var(--text-main);
      font-family: inherit;
      cursor: pointer;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 6px 2px;
      transition: transform 0.15s ease, border-color 0.15s ease;
    }

    .timeline-node:active {
      transform: scale(0.96);
    }

    .timeline-node .day-num {
      font-size: 1rem;
      color: var(--text-muted);
      font-weight: 600;
    }

    .timeline-node .day-code {
      font-size: 1.15rem;
      font-weight: 800;
      line-height: 1.2;
    }

    .timeline-node[data-type="A"] {
      border-color: var(--day-a-border);
      background: var(--day-a-bg);
      color: var(--day-a);
    }
    .timeline-node[data-type="P"] {
      border-color: var(--day-p-border);
      background: var(--day-p-bg);
      color: var(--day-p);
    }
    .timeline-node[data-type="S"] {
      border-color: var(--day-s-border);
      background: var(--day-s-bg);
      color: var(--day-s);
    }
    .timeline-node[data-type="R"] {
      border-color: var(--day-r-border);
      background: var(--day-r-bg);
      color: var(--day-r);
    }

    .timeline-node.active-node {
      box-shadow: 0 0 0 3px var(--text-main);
      transform: translateY(-2px);
    }

    .timeline-note {
      font-size: 1rem;
      background: var(--bg-subtle);
      border-radius: var(--radius-sm);
      padding: 10px 12px;
      color: var(--text-secondary);
      border-left: 4px solid var(--day-s);
    }

    /* Day Selector Tabs (Large Thumb-Friendly Buttons) */
    .day-tabs {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
      margin-bottom: 16px;
    }

    @media (min-width: 480px) {
      .day-tabs {
        grid-template-columns: repeat(4, 1fr);
      }
    }

    .day-tab-btn {
      min-height: 62px;
      padding: 10px 12px;
      border-radius: var(--radius-md);
      border: 2px solid var(--border-color);
      background: var(--bg-card);
      color: var(--text-main);
      font-family: inherit;
      font-size: 1.05rem;
      font-weight: 700;
      cursor: pointer;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 2px;
      box-shadow: var(--shadow-sm);
      transition: all 0.2s ease;
    }

    .day-tab-btn span.sub {
      font-size: 1rem;
      font-weight: 500;
      opacity: 0.9;
    }

    .day-tab-btn[data-day="A"].active {
      background: var(--day-a);
      border-color: var(--day-a);
      color: #ffffff;
    }
    .day-tab-btn[data-day="P"].active {
      background: var(--day-p);
      border-color: var(--day-p);
      color: #ffffff;
    }
    .day-tab-btn[data-day="S"].active {
      background: var(--day-s);
      border-color: var(--day-s);
      color: #ffffff;
    }
    .day-tab-btn[data-day="R"].active {
      background: var(--day-r);
      border-color: var(--day-r);
      color: #ffffff;
    }

    /* Active Day Banner & Progress Bar */
    .day-banner {
      border-radius: var(--radius-lg);
      padding: 16px;
      margin-bottom: 16px;
      border: 2px solid var(--active-border-tint);
      background: var(--active-bg-tint);
    }

    .day-banner-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      flex-wrap: wrap;
      gap: 10px;
      margin-bottom: 10px;
    }

    .day-banner-title {
      font-size: 1.25rem;
      font-weight: 800;
      color: var(--active-accent);
    }

    .day-rules-list {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-bottom: 12px;
    }

    .rule-chip {
      font-size: 1rem;
      font-weight: 600;
      background: var(--bg-card);
      color: var(--text-main);
      padding: 6px 12px;
      border-radius: var(--radius-sm);
      border: 1px solid var(--border-color);
    }

    .progress-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-top: 8px;
    }

    .progress-bar-wrap {
      flex: 1;
      height: 12px;
      background: var(--bg-card);
      border-radius: 999px;
      overflow: hidden;
      border: 1px solid var(--border-color);
    }

    .progress-bar-fill {
      height: 100%;
      width: 0%;
      background: var(--active-accent);
      transition: width 0.3s ease;
    }

    .progress-text {
      font-size: 1rem;
      font-weight: 700;
      min-width: 90px;
      text-align: right;
    }

    .beginner-pullup-box {
      margin-top: 12px;
      padding: 12px 14px;
      background: var(--bg-card);
      border-radius: var(--radius-sm);
      border-left: 4px solid var(--day-s);
      font-size: 1rem;
      color: var(--text-main);
    }

    /* Exercise Cards */
    .exercise-list {
      display: flex;
      flex-direction: column;
      gap: 16px;
      margin-bottom: 18px;
    }

    .exercise-card {
      background: var(--bg-card);
      border: 2px solid var(--border-color);
      border-radius: var(--radius-lg);
      overflow: hidden;
      box-shadow: var(--shadow-sm);
      transition: border-color 0.2s ease, opacity 0.2s ease;
    }

    .exercise-card.completed {
      border-color: var(--active-accent);
      background: var(--active-bg-tint);
    }

    .card-top-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 12px 16px;
      background: var(--bg-subtle);
      border-bottom: 1px solid var(--border-color);
      gap: 8px;
      flex-wrap: wrap;
    }

    .step-number {
      font-size: 1rem;
      font-weight: 800;
      color: var(--active-accent);
    }

    .king-badge {
      background: var(--king-bg);
      color: var(--king-gold);
      border: 1.5px solid var(--king-border);
      padding: 4px 12px;
      border-radius: 999px;
      font-size: 1rem;
      font-weight: 800;
      display: inline-flex;
      align-items: center;
      gap: 5px;
    }

    .card-illustration {
      width: 100%;
      background: var(--bg-subtle);
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 12px;
      border-bottom: 1px solid var(--border-color);
    }

    .card-illustration img {
      width: 100%;
      max-width: 340px;
      height: auto;
      border-radius: var(--radius-sm);
      display: block;
    }

    .card-body {
      padding: 16px;
    }

    .ex-title-th {
      font-size: 1.2rem;
      font-weight: 800;
      margin-bottom: 2px;
      color: var(--text-main);
    }

    .ex-title-en {
      font-size: 1rem;
      font-weight: 600;
      color: var(--text-muted);
      margin-bottom: 12px;
    }

    .prescription-pill {
      display: inline-block;
      font-size: 1.05rem;
      font-weight: 700;
      padding: 6px 14px;
      border-radius: var(--radius-sm);
      background: var(--active-bg-tint);
      color: var(--active-accent);
      border: 1px solid var(--active-border-tint);
      margin-bottom: 14px;
    }

    .tips-heading {
      font-size: 1rem;
      font-weight: 700;
      margin-bottom: 6px;
      color: var(--text-main);
    }

    .tips-list {
      padding-left: 20px;
      margin-bottom: 16px;
      color: var(--text-secondary);
      font-size: 1rem;
    }

    .tips-list li {
      margin-bottom: 4px;
    }

    /* Weight Tracker Box inside Card */
    .weight-box {
      background: var(--bg-subtle);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-md);
      padding: 12px;
      margin-bottom: 14px;
    }

    .weight-label-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 8px;
      margin-bottom: 8px;
    }

    .weight-label {
      font-size: 1rem;
      font-weight: 700;
      color: var(--text-main);
    }

    .weight-controls {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .weight-step-btn {
      min-width: 48px;
      min-height: 48px;
      border-radius: var(--radius-sm);
      border: 1px solid var(--border-color);
      background: var(--bg-card);
      color: var(--text-main);
      font-size: 1.2rem;
      font-weight: 800;
      cursor: pointer;
    }

    .weight-input {
      width: 92px;
      min-height: 48px;
      text-align: center;
      font-family: inherit;
      font-size: 1.1rem;
      font-weight: 700;
      border-radius: var(--radius-sm);
      border: 2px solid var(--border-color);
      background: var(--bg-card);
      color: var(--text-main);
      padding: 4px 8px;
    }

    .weight-unit {
      font-size: 1rem;
      font-weight: 600;
      color: var(--text-secondary);
    }

    .overload-rule {
      font-size: 1rem;
      color: var(--text-secondary);
      margin-top: 8px;
      padding-top: 8px;
      border-top: 1px dashed var(--border-color);
    }

    /* Card Action Buttons (Check & Rest Timer) */
    .card-actions {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 10px;
    }

    .check-btn {
      min-height: 54px;
      border-radius: var(--radius-md);
      border: 2px solid var(--active-accent);
      background: var(--bg-card);
      color: var(--active-accent);
      font-family: inherit;
      font-size: 1.05rem;
      font-weight: 800;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      padding: 10px 14px;
      transition: all 0.15s ease;
    }

    .check-btn.is-checked {
      background: var(--active-accent);
      color: #ffffff;
    }

    .quick-rest-btn {
      min-height: 54px;
      padding: 10px 14px;
      border-radius: var(--radius-md);
      border: 1px solid var(--border-color);
      background: var(--bg-subtle);
      color: var(--text-main);
      font-family: inherit;
      font-size: 1rem;
      font-weight: 700;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
    }

    /* Reset Controls */
    .reset-bar {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
      margin-bottom: 18px;
    }

    .reset-btn {
      flex: 1;
      min-height: 52px;
      padding: 10px 16px;
      border-radius: var(--radius-md);
      border: 1.5px solid var(--border-color);
      background: var(--bg-card);
      color: var(--text-main);
      font-family: inherit;
      font-size: 1rem;
      font-weight: 700;
      cursor: pointer;
    }

    /* Confirm Modal (In-page, sandbox safe) */
    .confirm-banner {
      display: none;
      background: var(--danger-bg);
      border: 2px solid var(--danger-border);
      border-radius: var(--radius-md);
      padding: 14px;
      margin-bottom: 18px;
    }

    .confirm-banner.show {
      display: block;
    }

    .confirm-text {
      font-size: 1rem;
      font-weight: 700;
      color: var(--danger-text);
      margin-bottom: 10px;
    }

    .confirm-actions {
      display: flex;
      gap: 10px;
    }

    .confirm-yes-btn, .confirm-no-btn {
      flex: 1;
      min-height: 48px;
      border-radius: var(--radius-sm);
      font-family: inherit;
      font-size: 1rem;
      font-weight: 700;
      cursor: pointer;
      border: none;
    }

    .confirm-yes-btn {
      background: #dc2626;
      color: #ffffff;
    }

