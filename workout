      function applyTheme() {
        var root = document.documentElement;
        var icon = document.getElementById('themeIcon');
        var text = document.getElementById('themeText');
        if (themeMode === 'light') {
          root.setAttribute('data-theme', 'light');
          icon.textContent = '☀️';
          text.textContent = 'โหมดสว่าง';
        } else if (themeMode === 'dark') {
          root.setAttribute('data-theme', 'dark');
          icon.textContent = '🌙';
          text.textContent = 'โหมดมืด';
        } else {
          root.removeAttribute('data-theme');
          icon.textContent = '🌓';
          text.textContent = 'อัตโนมัติ';
        }
      }

      document.getElementById('themeToggleBtn').addEventListener('click', function () {
        if (themeMode === 'auto') themeMode = 'dark';
        else if (themeMode === 'dark') themeMode = 'light';
        else themeMode = 'auto';
        safeSetItem('wk_theme_mode', themeMode);
        applyTheme();
      });

      // Render 7-Day Timeline
      function renderTimeline() {
        var track = document.getElementById('timelineTrack');
        track.innerHTML = '';
        weeklyTimeline.forEach(function (item, idx) {
          var btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'timeline-node' + (idx === activeTimelineIdx ? ' active-node' : '');
          btn.setAttribute('data-type', item.code);
          btn.setAttribute('aria-label', item.dayLabel + ' ' + item.name);
          btn.innerHTML =
            '<span class="day-num">ด.' + (idx + 1) + '</span>' +
            '<span class="day-code">' + item.code + '</span>';
          btn.addEventListener('click', function () {
            activeTimelineIdx = idx;
            safeSetItem('wk_timeline_idx', activeTimelineIdx);
            switchDay(item.code, true);
          });
          track.appendChild(btn);
        });
      }

      function applyDayAccentVariables(dayCode) {
        var c = dayColors[dayCode] || dayColors.A;
        document.documentElement.style.setProperty('--active-accent', c.accent);
        document.documentElement.style.setProperty('--active-bg-tint', c.bg);
        document.documentElement.style.setProperty('--active-border-tint', c.border);
      }

      function updateProgressUI(dayCode) {
        var list = workoutData[dayCode].exercises;
        var doneCount = 0;
        list.forEach(function (ex) {
          if (completedMap[ex.id]) doneCount++;
        });
        var pct = list.length > 0 ? Math.round((doneCount / list.length) * 100) : 0;
        document.getElementById('progressBarFill').style.width = pct + '%';
        document.getElementById('progressText').textContent = 'สำเร็จ ' + doneCount + '/' + list.length + ' ท่า';
      }

      function renderExercises(dayCode) {
        var dayObj = workoutData[dayCode];
        document.getElementById('dayBannerTitle').textContent = dayObj.title;
        document.getElementById('dayBannerDesc').textContent = dayObj.desc;

        var rulesContainer = document.getElementById('dayRulesList');
        rulesContainer.innerHTML = '';
        dayObj.rules.forEach(function (r) {
          var span = document.createElement('span');
          span.className = 'rule-chip';
          span.textContent = r;
          rulesContainer.appendChild(span);
        });

        var pullupBox = document.getElementById('pullupHelperBox');
        pullupBox.style.display = dayCode === 'S' ? 'block' : 'none';

        var container = document.getElementById('exerciseList');
        container.innerHTML = '';

        dayObj.exercises.forEach(function (ex, idx) {
          var isDone = !!completedMap[ex.id];
          var savedWeight = weightsMap[ex.id] !== undefined ? weightsMap[ex.id] : ex.defaultWeight;

          var card = document.createElement('article');
          card.className = 'exercise-card' + (isDone ? ' completed' : '');

          var kingHtml = ex.isKing
            ? '<span class="king-badge">👑 ท่าราชา (ท่าหลักประจำวัน)</span>'
            : '';

          var tipsItems = ex.tips.map(function (t) {
            return '<li>' + t + '</li>';
          }).join('');

          var weightSectionHtml = '';
          if (ex.hasWeight) {
            weightSectionHtml =
              '<div class="weight-box">' +
                '<div class="weight-label-row">' +
                  '<label class="weight-label" for="weight_' + ex.id + '">🏋️ น้ำหนักดัมเบลล่าสุด:</label>' +
                  '<div class="weight-controls">' +
                    '<button type="button" class="weight-step-btn" data-step="-1" data-ex="' + ex.id + '" aria-label="ลดน้ำหนัก 1 กิโลกรัม">−</button>' +
                    '<input type="number" id="weight_' + ex.id + '" class="weight-input" min="0" max="100" step="0.5" value="' + savedWeight + '" data-ex="' + ex.id + '">' +
                    '<button type="button" class="weight-step-btn" data-step="1" data-ex="' + ex.id + '" aria-label="เพิ่มน้ำหนัก 1 กิโลกรัม">+</button>' +
                    '<span class="weight-unit">กก.</span>' +
                  '</div>' +
                '</div>' +
                '<div class="overload-rule">📈 <strong>กฎเพิ่มความหนัก:</strong> ทำครบ 12 ครั้งทั้ง 3 เซ็ตสบาย ๆ ให้เพิ่ม <strong>1-2 กก.</strong></div>' +
              '</div>';
          }

          var customTimerSec = ex.timerSeconds || 60;
          var customTimerLabel = ex.timerSeconds ? ('⏱️ จับเวลาท่า ' + ex.timerSeconds + ' วิ') : '⏱️ พัก 60 วิ';

          card.innerHTML =
            '<div class="card-top-bar">' +
              '<span class="step-number">ท่าที่ ' + (idx + 1) + '</span>' +
              kingHtml +
            '</div>' +
            '<div class="card-illustration">' +
              '<img src="' + ex.img + '" alt="' + ex.alt + '" loading="lazy" width="320" height="200">' +
            '</div>' +
            '<div class="card-body">' +
              '<h3 class="ex-title-th">' + ex.thName + '</h3>' +
              '<p class="ex-title-en">' + ex.enName + '</p>' +
              '<div class="prescription-pill">' + ex.setsReps + '</div>' +
              '<p class="tips-heading">เทคนิคโฟกัสและเซฟข้อต่อ:</p>' +
              '<ul class="tips-list">' + tipsItems + '</ul>' +
              weightSectionHtml +
              '<div class="card-actions">' +
                '<button type="button" class="check-btn ' + (isDone ? 'is-checked' : '') + '" data-check="' + ex.id + '" aria-pressed="' + (isDone ? 'true' : 'false') + '">' +
                  '<span>' + (isDone ? '✅ ทำเสร็จแล้ว' : '⬜ ติ๊กเมื่อทำเสร็จ') + '</span>' +
                '</button>' +
                '<button type="button" class="quick-rest-btn" data-timer="' + customTimerSec + '">' +
                  customTimerLabel +
                '</button>' +
              '</div>' +
            '</div>';

          container.appendChild(card);
        });

        // Attach event listeners to newly rendered controls
        var checkBtns = container.querySelectorAll('[data-check]');
        checkBtns.forEach(function (btn) {
          btn.addEventListener('click', function () {
            var exId = btn.getAttribute('data-check');
            completedMap[exId] = !completedMap[exId];
            safeSetItem('wk_completed_map', completedMap);
            renderExercises(currentDay);
            updateProgressUI(currentDay);
            showToast(completedMap[exId] ? 'บันทึก: ทำท่านี้เสร็จแล้ว' : 'ยกเลิกการติ๊กท่านี้');
          });
        });

        var weightInputs = container.querySelectorAll('.weight-input');
        weightInputs.forEach(function (inp) {
          inp.addEventListener('change', function () {
            var exId = inp.getAttribute('data-ex');
            var val = parseFloat(inp.value);
            if (isNaN(val) || val < 0) val = 0;
            inp.value = val;
            weightsMap[exId] = String(val);
            safeSetItem('wk_weights_map', weightsMap);
            showToast('บันทึกน้ำหนัก ' + val + ' กก. แล้ว');
          });
        });

        var stepBtns = container.querySelectorAll('.weight-step-btn');
        stepBtns.forEach(function (sbtn) {
          sbtn.addEventListener('click', function () {
            var exId = sbtn.getAttribute('data-ex');
            var delta = parseFloat(sbtn.getAttribute('data-step'));
            var inputEl = document.getElementById('weight_' + exId);
            var currentVal = parseFloat(inputEl.value) || 0;
            var nextVal = Math.max(0, currentVal + delta);
            inputEl.value = nextVal;
            weightsMap[exId] = String(nextVal);
            safeSetItem('wk_weights_map', weightsMap);
            showToast('อัปเดตน้ำหนักเป็น ' + nextVal + ' กก.');
          });
        });

        var quickTimerBtns = container.querySelectorAll('[data-timer]');
        quickTimerBtns.forEach(function (tbtn) {
          tbtn.addEventListener('click', function () {
            var secs = parseInt(tbtn.getAttribute('data-timer'), 10) || 60;
            startCountdown(secs);
          });
        });

        updateProgressUI(dayCode);
      }

      function switchDay(dayCode, fromTimeline) {
        currentDay = dayCode;
        safeSetItem('wk_selected_day', currentDay);

        if (!fromTimeline) {
          // Highlight the first matching node on the timeline
          for (var i = 0; i < weeklyTimeline.length; i++) {
            if (weeklyTimeline[i].code === dayCode) {
              activeTimelineIdx = i;
              safeSetItem('wk_timeline_idx', activeTimelineIdx);
              break;
            }
          }
        }

        var tabBtns = document.querySelectorAll('.day-tab-btn');
        tabBtns.forEach(function (b) {
          if (b.getAttribute('data-day') === dayCode) {
            b.classList.add('active');
          } else {
            b.classList.remove('active');
          }
        });

        applyDayAccentVariables(dayCode);
        renderTimeline();
        renderExercises(dayCode);
      }

      // Attach Day Tab Click Listeners
      document.querySelectorAll('.day-tab-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
          switchDay(btn.getAttribute('data-day'), false);
        });
      });

      // Reset Confirmation Flow (No browser alert/confirm)
      var pendingResetScope = null; // 'day' or 'all'
      var confirmBanner = document.getElementById('confirmBanner');
      var confirmText = document.getElementById('confirmText');

      document.getElementById('resetDayBtn').addEventListener('click', function () {
        pendingResetScope = 'day';
        confirmText.textContent = 'ต้องการล้างเครื่องหมายติ๊กทำเสร็จของ "วัน ' + currentDay + '" ใช่หรือไม่? (น้ำหนักดัมเบลที่จดไว้จะยังอยู่ครบ)';
        confirmBanner.classList.add('show');
      });

      document.getElementById('resetAllBtn').addEventListener('click', function () {
        pendingResetScope = 'all';
        confirmText.textContent = 'ต้องการล้างเครื่องหมายติ๊กทำเสร็จของ "ทุกวัน (A, P, S, R)" ใช่หรือไม่? (น้ำหนักดัมเบลที่จดไว้จะยังอยู่ครบ)';
        confirmBanner.classList.add('show');
      });

      document.getElementById('confirmYesBtn').addEventListener('click', function () {
        if (pendingResetScope === 'day') {
          workoutData[currentDay].exercises.forEach(function (ex) {
            delete completedMap[ex.id];
          });
          showToast('รีเซ็ตติ๊กถูกของวัน ' + currentDay + ' เรียบร้อย');
        } else if (pendingResetScope === 'all') {
          completedMap = {};
          showToast('รีเซ็ตติ๊กถูกทุกวันเรียบร้อย');
        }
        safeSetItem('wk_completed_map', completedMap);
        confirmBanner.classList.remove('show');
        pendingResetScope = null;
        renderExercises(currentDay);
      });

      document.getElementById('confirmNoBtn').addEventListener('click', function () {
        confirmBanner.classList.remove('show');
        pendingResetScope = null;
      });

      // 60-Second Rest Timer with Web Audio API Beep
      var timerInterval = null;
      var remainingSeconds = 60;
      var isRunning = false;

      function playFinishBeep() {
        try {
          var AudioCtx = window.AudioContext || window.webkitAudioContext;
          if (!AudioCtx) return;
          var ctx = new AudioCtx();
          var osc = ctx.createOscillator();
          var gain = ctx.createGain();
          osc.type = 'sine';
          osc.frequency.setValueAtTime(880, ctx.currentTime);
          gain.gain.setValueAtTime(0.18, ctx.currentTime);
          osc.connect(gain);
          gain.connect(ctx.destination);
          osc.start();
          osc.stop(ctx.currentTime + 0.35);
        } catch (e) {
          // Ignore audio error if blocked
        }
      }

      function formatTime(sec) {
        var m = Math.floor(sec / 60);
        var s = sec % 60;
        return (m < 10 ? '0' + m : m) + ':' + (s < 10 ? '0' + s : s);
      }

      function updateTimerUI() {
        var clockEl = document.getElementById('timerClock');
        var statusEl = document.getElementById('timerStatus');
        var startBtn = document.getElementById('timerStartBtn');
        clockEl.textContent = formatTime(remainingSeconds);
        if (isRunning) {
          startBtn.textContent = '⏸️ หยุดชั่วคราว';
          statusEl.innerHTML = 'กำลังนับถอยหลัง...<br>เตรียมตัวเซ็ตถัดไป';
        } else if (remainingSeconds === 0) {
          startBtn.textContent = '▶️ เริ่มใหม่ 60 วิ';
          statusEl.innerHTML = '🔔 ครบเวลาแล้ว!<br>ลุยเซ็ตต่อไปได้เลย';
        } else {
          startBtn.textContent = '▶️ จับเวลาพัก 60 วิ';
          statusEl.innerHTML = 'พักระหว่างเซ็ต<br>60 วินาที';
        }
      }

      function startCountdown(customSeconds) {
        if (timerInterval) {
          clearInterval(timerInterval);
          timerInterval = null;
        }
        if (typeof customSeconds === 'number') {
          remainingSeconds = customSeconds;
        } else if (remainingSeconds <= 0) {
          remainingSeconds = 60;
        }
        isRunning = true;
        updateTimerUI();

        timerInterval = setInterval(function () {
          remainingSeconds--;
          if (remainingSeconds <= 0) {
            remainingSeconds = 0;
            clearInterval(timerInterval);
            timerInterval = null;
            isRunning = false;
            playFinishBeep();
            showToast('🔔 ครบเวลาพักแล้ว! เริ่มเซ็ตต่อไปได้เลย');
          }
          updateTimerUI();
        }, 1000);
      }

      document.getElementById('timerStartBtn').addEventListener('click', function () {
        if (isRunning) {
          clearInterval(timerInterval);
          timerInterval = null;
          isRunning = false;
          updateTimerUI();
        } else {
          startCountdown(remainingSeconds > 0 ? remainingSeconds : 60);
        }
      });

      document.getElementById('timerResetBtn').addEventListener('click', function () {
        if (timerInterval) {
          clearInterval(timerInterval);
          timerInterval = null;
        }
        isRunning = false;
        remainingSeconds = 60;
        updateTimerUI();
      });

      // Initialize App
      applyTheme();
      switchDay(currentDay, true);
      updateTimerUI();
    })();
  </script>
</body>
</html>
